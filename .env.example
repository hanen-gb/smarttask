# ─────────────────────────────────────────────────────────────────────────────
#  SmartTask — modèle de variables d'environnement
#
#  ⚠️  Ce fichier (.env.example) EST versionné dans git : il documente les
#      variables attendues, avec des valeurs factices.
#
#  ⚠️  Le fichier .env réel N'EST PAS versionné (voir .gitignore) : il contient
#      les vrais secrets.
#
#  Pour démarrer :  copier ce fichier en .env puis adapter les valeurs.
#      PowerShell :  Copy-Item .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données ──────────────────────────────────────────────────────────
POSTGRES_DB=smarttask
POSTGRES_USER=smarttask
POSTGRES_PASSWORD=smarttask
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/smarttask
SPRING_DATASOURCE_USERNAME=smarttask
SPRING_DATASOURCE_PASSWORD=smarttask

# ── Backend ──────────────────────────────────────────────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ── JWT  (étape 4) ───────────────────────────────────────────────────────────
# Clé de signature des tokens. DOIT faire au moins 32 caractères (256 bits)
# pour l'algorithme HS256. En production : une valeur aléatoire, jamais celle-ci.
#
# Générer une clé solide :
#   PowerShell : [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_SECRET=changez-cette-cle-en-production-minimum-32-caracteres
JWT_ACCESS_TOKEN_EXPIRATION=900000        # 15 minutes, en millisecondes
JWT_REFRESH_TOKEN_EXPIRATION=604800000    # 7 jours, en millisecondes

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ── Fichiers joints  (étape 10) ──────────────────────────────────────────────
FILE_STORAGE_LOCATION=./uploads
FILE_MAX_SIZE=10MB

# ── Module IA  (étape 14) ────────────────────────────────────────────────────
# ⚠️  Clé secrète : utilisée UNIQUEMENT côté backend, jamais envoyée au frontend.
AI_API_KEY=
AI_MODEL=claude-sonnet-5
AI_ENABLED=false
